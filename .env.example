# NicrronNinoo: redeem COLUMBIA26, then copy base URL + key + model ids from the sponsor guide
NICRRON_API_KEY=
NICRRON_BASE_URL=
READER_A_MODEL=
READER_B_MODEL=

# PRISM by Block Convey: values come from the onboarding brief (key shown once). Never commit real values.
PRISMTRACE_API_KEY=pt-sk-...
PRISMTRACE_PROJECT_ID=
PRISMTRACE_HOST=https://prism-api-prod.up.railway.app
AGENT_PREFIX=verifill

# 0 = also call RxNav + NPPES live for drugs/NPIs outside backend/data (fails safe to amber). 1 = local data only
VERIFILL_OFFLINE=0


# Second OCR engine that confirms reader values on the page: rapidocr (default) | easyocr | tesseract
GROUND_OCR=rapidocr
# Windows only: Tesseract binary (auto-detected at C:\Program Files\Tesseract-OCR if left empty)
TESSERACT_CMD=
